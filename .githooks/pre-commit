#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_java_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(java|kt|groovy)$' || true)

if [[ -z "$staged_java_files" ]]; then
  echo "No staged Java/Kotlin/Groovy files detected. Skipping format and test checks."
  exit 0
fi

run_maven() {
  local dir="$1"
  if [[ -x "$dir/mvnw" ]]; then
    (cd "$dir" && ./mvnw -q spotless:apply test)
  else
    (cd "$dir" && mvn -q spotless:apply test)
  fi
}

for pom in $(find "$repo_root" -name pom.xml -not -path '*/target/*' -print); do
  project_dir=$(dirname "$pom")

  if grep -q 'spotless-maven-plugin' "$pom" 2>/dev/null; then
    echo "Running formatter and tests for $project_dir"
    run_maven "$project_dir" || {
      echo "Pre-commit checks failed in $project_dir"
      exit 1
    }
  else
    echo "Skipping formatter for $project_dir: no Spotless plugin configured. Running Maven test only."
    if [[ -x "$project_dir/mvnw" ]]; then
      (cd "$project_dir" && ./mvnw -q test) || {
        echo "Pre-commit test failed in $project_dir"
        exit 1
      }
    else
      (cd "$project_dir" && mvn -q test) || {
        echo "Pre-commit test failed in $project_dir"
        exit 1
      }
    fi
  fi
done

echo "Pre-commit checks passed."
